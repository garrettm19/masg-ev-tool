# Copy this to .env and fill in your keys
# cp .env.example .env

# Polymarket Gamma API (no key required — public endpoint)
GAMMA_API_BASE=https://gamma-api.polymarket.com

# The Odds API — https://the-odds-api.com
# Sign up for free: 500 requests/month
ODDS_API_KEY=your_odds_api_key_here

# Kalshi API — https://kalshi.com (optional)
# Generate at: https://kalshi.com/account/settings
KALSHI_API_KEY=your_kalshi_api_key_here

# Pushover — https://pushover.net (optional, for phone alerts)
# 1. Create account at pushover.net
# 2. Your user key is on the dashboard
# 3. Create an app at pushover.net/apps/build to get the API token
PUSHOVER_USER_KEY=your_pushover_user_key_here
PUSHOVER_API_TOKEN=your_pushover_api_token_here
